AI_COUNCIL_DATA_DIR=./data
AI_COUNCIL_MODEL_CONFIG_PATH=./config/models.yaml
# Mode catalog (red-blue/courtroom/debate/...); defaults to config/modes.yaml if unset.
AI_COUNCIL_MODES_CONFIG_PATH=./config/modes.yaml
AI_COUNCIL_PROMPT_DIR=./prompts
# Case file character limits; both must be positive and total must be at least per-file.
AI_COUNCIL_MAX_CASE_FILE_CHARS=50000
AI_COUNCIL_MAX_TOTAL_CASE_FILE_CHARS=120000
VITE_API_BASE_URL=http://localhost:5009
